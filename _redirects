# Anime Destiny es un sitio estatico multipagina, no una SPA: cada seccion es
# su propio .html y no hay routing en cliente. Netlify sirve primero el archivo
# que exista, asi que esta regla solo alcanza a las URLs inexistentes.
#
# Antes decia "/* /index.html 200", que devolvia la portada con codigo 200 para
# cualquier ruta rota. Eso dejaba 404.html sin usar y hacia que los buscadores
# vieran infinitas URLs distintas con contenido identico (soft 404).

# El selector de mascota paso a llamarse "personajes"; se conserva la URL vieja
# con una redireccion permanente para no romper enlaces guardados.
/mascotas.html /personajes.html 301

# Carpetas y archivos de desarrollo: estan en el repo pero no son parte del
# sitio. Netlify publica toda la raiz (no hay carpeta de publicacion), asi que
# sin estas reglas cualquiera podia abrir prototipos, docs, el esquema SQL o los
# tests. El "!" fuerza el 404 aunque el archivo exista.
/tools/*            /404.html 404!
/docs/*             /404.html 404!
/viz/*              /404.html 404!
/server/*           /404.html 404!
/tests/*            /404.html 404!
/code-map.json      /404.html 404!
/package.json       /404.html 404!
/package-lock.json  /404.html 404!
/vitest.config.js   /404.html 404!
/netlify.toml       /404.html 404!
/vercel.json        /404.html 404!
/js/core/config.template.js /404.html 404!

